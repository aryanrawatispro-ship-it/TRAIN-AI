# ============================================================
# Train-My-AI Platform - Environment Variables
# ============================================================
# Copy this file to .env and update with your values

# ============================================================
# Database
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trainmyai
POSTGRES_USER=trainmyai
POSTGRES_PASSWORD=changeme_in_production

# Connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ============================================================
# Redis (Cache & Queue)
# ============================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================================
# Object Storage (S3/MinIO)
# ============================================================
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=train-my-ai
S3_REGION=us-west-2
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# For AWS S3 (production)
# S3_ENDPOINT=https://s3.us-west-2.amazonaws.com
# S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ============================================================
# Secrets Management (HashiCorp Vault)
# ============================================================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root

# For production (use AppRole auth)
# VAULT_ROLE_ID=your-role-id
# VAULT_SECRET_ID=your-secret-id

# ============================================================
# Authentication & Security
# ============================================================
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Password hashing
BCRYPT_ROUNDS=12

# ============================================================
# External APIs
# ============================================================
# OpenAI (for RAG embeddings)
OPENAI_API_KEY=sk-proj-...

# Anthropic (for LLM judge)
ANTHROPIC_API_KEY=sk-ant-...

# HuggingFace (for model downloads)
HUGGINGFACE_TOKEN=hf_...

# Cohere (for reranking)
COHERE_API_KEY=

# ============================================================
# MLflow (Experiment Tracking)
# ============================================================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ============================================================
# Billing (Stripe)
# ============================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================
# Email / Notifications
# ============================================================
# SendGrid
SENDGRID_API_KEY=
FROM_EMAIL=noreply@train-my-ai.com

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================================
# Application Settings
# ============================================================
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR, CRITICAL
WORKERS=4               # Uvicorn workers

# CORS
CORS_ORIGINS=http://localhost:3000,https://app.train-my-ai.com

# Rate limiting
RATE_LIMIT_PER_MINUTE=100

# ============================================================
# Frontend
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ============================================================
# Monitoring
# ============================================================
# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Sentry (error tracking)
SENTRY_DSN=

# ============================================================
# Kubernetes / Cloud
# ============================================================
K8S_NAMESPACE=train-my-ai
K8S_CLUSTER_NAME=train-my-ai-prod

# Cloud provider
CLOUD_PROVIDER=gcp  # gcp, aws, azure

# GCP
GCP_PROJECT_ID=
GCP_REGION=us-west2
GCS_BUCKET=train-my-ai-prod

# AWS
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=

# ============================================================
# GPU Settings
# ============================================================
# Default GPU types
DEFAULT_GPU_TYPE=A10
GPU_PRICING_A10=1.50
GPU_PRICING_A100=3.00
GPU_PRICING_T4=0.90

# BYO GPU platform fee
BYO_GPU_PLATFORM_FEE=0.10

# ============================================================
# Feature Flags
# ============================================================
ENABLE_BYO_GPU=true
ENABLE_SFT_TRAINING=true
ENABLE_RAG_TRAINING=true
ENABLE_BILLING=false  # Enable in production
ENABLE_EMAIL_NOTIFICATIONS=false

# ============================================================
# Development / Testing
# ============================================================
# Skip auth for testing (NEVER enable in production!)
SKIP_AUTH=false

# Demo mode (seed with demo data)
DEMO_MODE=true
